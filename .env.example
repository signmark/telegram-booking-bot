# Booking bot — all variables, no values. Copy to .env and fill in.
# .env is ignored by git; never commit real tokens.

# --- required ---
# Bot token from @BotFather (/newbot)
TELEGRAM_BOT_TOKEN=
# Payment provider token: the test provider from @BotFather -> your bot -> Payments (demo),
# or your real provider (ЮKassa / Stripe / Smart Glocal) for live payments
PAYMENT_PROVIDER_TOKEN=
# Sandbox card number of the test provider — shown in the demo disclaimer; never hardcode it
TEST_CARD_NUMBER=

# --- optional (defaults in comments) ---
# Bot @username without @ (for share links)
BOT_USERNAME=
# Invoice currency: RUB / USD / EUR (default: RUB)
CURRENCY=
# Comma-separated Telegram user ids: admin commands and refund alerts
ADMIN_IDS=
# sqlite database file (default: data/bookings.sqlite3)
DB_PATH=
# 1 — demo mode: reminders in 1–2 minutes, cancel window 1 minute (default: off)
DEMO_FAST=
# Hours before the start when cancelling is still allowed (default: 12)
CANCEL_HOURS=
# Minutes the slot is held while the invoice is open (default: 15)
HOLD_MINUTES=
# Days ahead the slot grid is created (default: 14)
SEED_DAYS=
# Salon time zone (default: Europe/Moscow)
TZ_NAME=
